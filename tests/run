#!/usr/bin/env bash
# tests/run: the whole suite. Prints ok:/FAIL: lines; exits 1 on any failure.
# Needs no hardware, network or root: Bootloader drives are faked as directories.
set -uo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
FAILS=0
ok()   { printf 'ok: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1"; FAILS=$((FAILS + 1)); }
check() { if eval "$2"; then ok "$1"; else fail "$1"; fi; }

# Compare two keymaps ignoring whitespace: the editor column-aligns layers, go60-gen does not.
tokens() { tr -s ' \t\n' '\n\n\n' < "$1"; }

# --- go60-gen -------------------------------------------------------------

for g in "$ROOT"/tests/golden/*/; do
  name=$(basename "$g")
  out=$(mktemp)
  if "$ROOT/bin/go60-gen" < "$g/layout.json" > "$out" && diff -q <(tokens "$out") <(tokens "$g/keymap") >/dev/null; then
    ok "go60-gen golden $name"
  else
    fail "go60-gen golden $name (diff <(tr -s ' \\n' '\\n\\n' < $g/keymap) <(bin/go60-gen < $g/layout.json | tr -s ' \\n' '\\n\\n'))"
  fi
  rm -f "$out"
done

check "go60-gen: committed Keymap is current" \
  'diff -q <("$ROOT/bin/go60-gen" < "$ROOT/config/go60.json") "$ROOT/config/go60.keymap" >/dev/null'

check "go60-gen: refuses a non-go60 Layout" \
  '! echo "{\"keyboard\":\"glove80\"}" | "$ROOT/bin/go60-gen" >/dev/null 2>&1'

check "go60-gen: refuses non-JSON" '! echo nope | "$ROOT/bin/go60-gen" >/dev/null 2>&1'

# --- go60-import ----------------------------------------------------------

T=$(mktemp -d)
if [[ -n "${KEEP:-}" ]]; then echo "kept: $T" >&2; else trap 'rm -rf "$T"' EXIT; fi
G="$ROOT/tests/golden/tailorkey-4.2l"

# A throwaway copy of the repo shape go60-import writes into.
repo="$T/repo"
mkdir -p "$repo/config" "$repo/tests/golden"
git -C "$repo" init -q
cp "$ROOT/config/go60.conf" "$repo/config/"

check "go60-import: writes Layout and Keymap" \
  '(cd "$repo" && "$ROOT/bin/go60-import" "$G/layout.json" >/dev/null) \
   && cmp -s "$repo/config/go60.json" "$G/layout.json" \
   && diff -q <(tokens "$repo/config/go60.keymap") <(tokens "$G/keymap") >/dev/null'

check "go60-import: accepts a matching editor Keymap" \
  '(cd "$repo" && "$ROOT/bin/go60-import" "$G/layout.json" "$G/keymap" >/dev/null 2>&1)'

sed 's/&kp EQUAL/\&kp PLUS/' "$G/keymap" > "$T/wrong.keymap"
check "go60-import: mismatching editor Keymap fails and saves a golden pair" \
  '! (cd "$repo" && "$ROOT/bin/go60-import" "$G/layout.json" "$T/wrong.keymap" >/dev/null 2>&1) \
   && ls "$repo"/tests/golden/*/keymap >/dev/null 2>&1'

check "go60-import: refuses outside a go60 checkout" \
  '! (cd "$T" && "$ROOT/bin/go60-import" "$G/layout.json" >/dev/null 2>&1)'

# --- go60-train -----------------------------------------------------------

page="$T/trainer.html"
"$ROOT/bin/go60-train" < "$ROOT/config/go60.json" > "$page" 2>"$T/train.err"; train_rc=$?
reach() { node "$ROOT/tests/page.js" "$page" "$1"; }

check "go60-train: builds a page from the repo's Layout" '[[ $train_rc == 0 && -s "$page" && ! -s "$T/train.err" ]]'

check "go60-train: page carries the Layout" \
  'diff -q <(reach layout | jq -S .) <(jq -S . "$ROOT/config/go60.json") >/dev/null'

check "go60-train: page carries the board's key positions" \
  'diff -q <(reach keys | jq -S .) <(jq -S .layouts.LAYOUT.layout "$ROOT/config/info.json") >/dev/null'

check "go60-train: page loads nothing from the network" \
  '! grep -Eq "(src|href)=\"?(https?:)?//|url\\((https?:)?//|@import|fetch\\(" "$page"'

check "go60-train: refuses non-JSON, with a message and no page" \
  '! echo nope | "$ROOT/bin/go60-train" >"$T/bad.out" 2>"$T/bad.err" && [[ ! -s "$T/bad.out" ]] && grep -q "go60-train:" "$T/bad.err"'

check "go60-train: refuses a non-go60 Layout" \
  '! echo "{\"keyboard\":\"glove80\"}" | "$ROOT/bin/go60-train" >/dev/null 2>&1'

check "go60-train: refuses a layer with the wrong number of keys" \
  '! jq ".layers[3] |= .[1:]" "$ROOT/config/go60.json" | "$ROOT/bin/go60-train" >/dev/null 2>&1'

printf '#!/bin/sh\necho "$1" > "%s"\n' "$T/opened" > "$T/browser"; chmod +x "$T/browser"
check "go60-train --open: writes the page under the cache directory and opens it, from any directory" \
  '(cd "$T" && GO60_REPO="$ROOT" XDG_CACHE_HOME="$T/cache" BROWSER="$T/browser %s" "$ROOT/bin/go60-train" --open >/dev/null 2>&1) \
   && [[ "$(cat "$T/opened")" == "file://$T/cache/go60/trainer.html" ]] \
   && cmp -s "$T/cache/go60/trainer.html" "$page"'

# Installed by cfg: <prefix>/lib/go60/{bin,lib,config/info.json}, a bin symlink, no Layout.
inst="$T/inst"; mkdir -p "$inst/lib/go60/bin" "$inst/lib/go60/lib" "$inst/lib/go60/config" "$inst/bin" "$T/elsewhere"
cp "$ROOT/bin/go60-train" "$inst/lib/go60/bin/"; cp "$ROOT/lib/trainer.html" "$inst/lib/go60/lib/"
cp "$ROOT/config/info.json" "$inst/lib/go60/config/"; ln -s ../lib/go60/bin/go60-train "$inst/bin/go60-train"
rm -f "$T/opened"
check "go60-train --open: installed, finds the Layout in GO60_REPO from an unrelated directory" \
  '(cd "$T/elsewhere" && GO60_REPO="$ROOT" XDG_CACHE_HOME="$T/cache2" BROWSER="$T/browser %s" "$inst/bin/go60-train" --open >/dev/null 2>"$T/inst.err") \
   && [[ "$(cat "$T/opened")" == "file://$T/cache2/go60/trainer.html" ]] \
   && cmp -s "$T/cache2/go60/trainer.html" "$page" || { cat "$T/inst.err" >&2; false; }'

check "go60-train --open: installed, prefers the git checkout it runs in" \
  '(cd "$repo/config" && GO60_REPO="$ROOT" XDG_CACHE_HOME="$T/cache3" BROWSER="$T/browser %s" "$inst/bin/go60-train" --open >/dev/null 2>&1) \
   && diff -q <(page="$T/cache3/go60/trainer.html" reach layout | jq -S .) <(jq -S . "$repo/config/go60.json") >/dev/null'

check "go60-train --open: no Layout anywhere says so, without a traceback" \
  '! (cd "$T/elsewhere" && GO60_REPO="$T/nowhere" XDG_CACHE_HOME="$T/cache4" BROWSER="$T/browser %s" "$inst/bin/go60-train" --open >/dev/null 2>"$T/none.err") \
   && grep -q "^go60-train: .*go60.json" "$T/none.err" && ! grep -q Traceback "$T/none.err" && [[ ! -e "$T/cache4" ]]'

# Each way the input can be unreadable gives a go60-train: message, no traceback and no page.
nomsg() { grep -q "^go60-train: " "$1" && ! grep -q Traceback "$1"; }
jq '.title = "BAD"' "$ROOT/config/go60.json" | sed 's/"BAD"/"\xff"/' > "$T/latin1.json"
check "go60-train: refuses non-UTF-8 input, with a message and no page" \
  '! "$ROOT/bin/go60-train" < "$T/latin1.json" >"$T/u8.out" 2>"$T/u8.err" && [[ ! -s "$T/u8.out" ]] && nomsg "$T/u8.err" && grep -q UTF-8 "$T/u8.err"'

unr="$T/unreadable"; mkdir -p "$unr/config"; cp "$ROOT/config/go60.json" "$unr/config/"; chmod 000 "$unr/config/go60.json"
check "go60-train --open: an unreadable Layout says so, without a traceback" \
  '! (cd "$T/elsewhere" && GO60_REPO="$unr" XDG_CACHE_HOME="$T/cache5" BROWSER="$T/browser %s" "$inst/bin/go60-train" --open >/dev/null 2>"$T/unr.err") \
   && nomsg "$T/unr.err" && [[ ! -e "$T/cache5/go60/trainer.html" ]]'
chmod 644 "$unr/config/go60.json"

noinfo="$T/noinfo"; mkdir -p "$noinfo/bin" "$noinfo/lib" "$noinfo/config"
cp "$ROOT/bin/go60-train" "$noinfo/bin/"; cp "$ROOT/lib/trainer.html" "$noinfo/lib/"
check "go60-train: a missing info.json says so, without a traceback" \
  '! "$noinfo/bin/go60-train" < "$ROOT/config/go60.json" >"$T/ni.out" 2>"$T/ni.err" && [[ ! -s "$T/ni.out" ]] && nomsg "$T/ni.err"'
echo '{"layouts":' > "$noinfo/config/info.json"
check "go60-train: a bad info.json says so, without a traceback" \
  '! "$noinfo/bin/go60-train" < "$ROOT/config/go60.json" >"$T/bi.out" 2>"$T/bi.err" && [[ ! -s "$T/bi.out" ]] && nomsg "$T/bi.err"'

renamed="$T/renamed.html"
jq '.layer_names[-1] = "Sparkle"' "$ROOT/config/go60.json" | "$ROOT/bin/go60-train" > "$renamed"
check "Reach: the magic key finds its layer when that layer is renamed" \
  '[[ "$(page="$renamed" reach "Reach.key(layout, 0, 36).hold")" == "\"Sparkle\"" ]]'

check "Reach: every layer of the Layout can be picked" \
  '[[ "$(reach "Reach.layers(layout).map(l => l.name)")" == "$(jq -c .layer_names "$ROOT/config/go60.json")" ]]'

check "Reach: a home-row hold-tap shows its tap and its hold" \
  '[[ "$(reach "(k => [k.tap, k.hold])(Reach.key(layout, 0, 25))")" == "[\"N\",\"GUI\"]" ]]'

check "Reach: a thumb hold-tap says in words what it sends" \
  'reach "Reach.key(layout, 0, 54).words" | grep -q "Tap: Backspace. Hold: Cursor layer while held"'

check "Reach: a shifted key shows the character it types" \
  '[[ "$(reach "Reach.key(layout, 13, 2).tap")" == "\"(\"" ]]'

check "Reach: a pass-through key shows what it falls through to" \
  '[[ "$(reach "(k => [k.through, k.tap])(Reach.key(layout, 15, 16))")" == "[\"Mouse\",\"$(reach "Reach.key(layout, 14, 16).tap" | jq -r .)\"]" ]] \
   && [[ "$(reach "Reach.key(layout, 12, 50).through")" == "\"HRM_WinLinx\"" ]]'

# Reach answers "how do I produce this output?" as the keys to hold and the keys to tap, on HRM_WinLinx.
path() { reach "(p => p && [p.hold, p.tap])(Reach.reach(layout, $1))"; }
check "Reach: a lowercase letter is one tap" '[[ "$(path "\"a\"")" == "[[],[32]]" ]]'
check "Reach: a symbol comes from a thumb hold" '[[ "$(path "\"{\"")" == "[[59],[14]]" ]]'
check "Reach: a function key comes from its combo" \
  '[[ "$(path "\"F1\"")" == "[[],[1,13]]" ]] && [[ "$(reach "!!Reach.reach(layout, \"F1\").combo")" == true ]]'
check "Reach: a modifier comes from a home-row hold" '[[ "$(path "\"Left Ctrl\"")" == "[[27],[]]" ]]'
check "Reach: a capital comes from a cross-hand Shift" '[[ "$(path "\"A\"")" == "[[28],[32]]" ]]'
check "Reach: a key found only on Magic" \
  '[[ "$(path "\"Bootloader\"")" == "[[36],[12]]" ]] && [[ "$(reach "Reach.reach(layout, \"Bootloader\").layer")" == 18 ]]'
check "Reach: a chord on a thumb layer" \
  '[[ "$(reach "Reach.paths(layout, \"Ctrl+Z\").map(p => p.hold.length + \",\" + p.tap.length)[0]")" == "\"1,1\"" ]] \
   && [[ "$(reach "Reach.paths(layout, \"Ctrl+Z\").some(p => p.hold == 54 && p.tap == 15)")" == true ]]'
check "Reach: among equal routes, a thumb layer-hold beats a plain layer key" \
  '[[ "$(reach "(p => [p.hold, p.layer])(Reach.paths(layout, \"Ctrl+Z\")[0])")" == "[[54],11]" ]] \
   && reach "Reach.paths(layout, \"Ctrl+Z\")[0].words" | grep -q "^\"Hold ⌫ (Cursor), then tap ⌃Z"'
check "Reach: a route through a plain layer key names the key" \
  '[[ "$(reach "Reach.paths(layout, \"Ctrl+Z\").filter(p => p.hold == 47)[0].words")" == "\"Hold the right-hand key in row 4, column 6 (Keypad), then tap ⌃Z. Ctrl+Z.\"" ]]'
check "Reach: an output the board cannot make is null" '[[ "$(path "\"no such key\"")" == null ]]'
check "Reach: the path says in words what to do" \
  'reach "Reach.reach(layout, \"{\").words" | grep -q "Hold ␣ (Symbol), then tap {"'

jq 'walk(if type == "string" then gsub("TKZ"; "ZZZ") | gsub("HRM"; "QQQ") | gsub("thumb|space"; "tt") else . end)' \
  "$ROOT/config/go60.json" | "$ROOT/bin/go60-train" > "$T/names.html"
check "Reach: reads hold-taps and macros by structure, not by name" \
  '[[ "$(page="$T/names.html" path "\"A\"")" == "[[28],[32]]" && "$(page="$T/names.html" path "\"{\"")" == "[[59],[14]]" ]]'

# Magic is held from the base and from Keypad. Make one of its keys pass-through: each route falls to its own layer.
jq '.layers[18][9] = {"value": "&trans", "params": []}' "$ROOT/config/go60.json" | "$ROOT/bin/go60-train" > "$T/routes.html"
check "Reach: a pass-through key falls to the next lower active layer, on each route" \
  '[[ "$(page="$T/routes.html" reach "Reach.ways(layout, 18).filter(w => w.how == \"hold\" && w.base == 0).map(w => (k => [w.hold, k.through, k.tap])(Reach.key(layout, 18, 9, w.active)))")" \
      == "[[[36],\"HRM_WinLinx\",\"9\"],[[47,36],\"Keypad\",\"F9\"],[[55,36],\"Keypad\",\"F9\"]]" ]]'

check "Reach: each layer says how to reach it" \
  '[[ "$(reach "Reach.ways(layout, 13)[0].hold")" == "[59]" ]] \
   && [[ "$(reach "Reach.layers(layout).every(l => l.index == 0 || Reach.ways(layout, l.index).length > 0)")" == true ]]'

check "Reach: the three base modes, switched on Magic" \
  '[[ "$(reach "Reach.bases(layout)")" == "[0,1,2]" ]] \
   && [[ "$(reach "(w => [w.how, w.hold, w.tap])(Reach.ways(layout, 1)[0])")" == "[\"switch\",[36],50]" ]]'

check "Reach: every layer has a note; per-finger notes explain home-row mods" \
  '[[ "$(reach "Reach.layers(layout).every(l => Reach.note(layout, l.index).length > 20)")" == true ]] \
   && reach "Reach.note(layout, 6)" | grep -qi "home-row" \
   && reach "Reach.note(layout, 6)" | grep -qi "cross-hand" \
   && reach "Reach.note(layout, 6)" | grep -qi "stacked" \
   && reach "Reach.note(layout, 6)" | grep -qi "same-hand"'

check "Reach: Magic warns about its bootloader, reset and Bluetooth-clear keys" \
  'reach "Reach.note(layout, 18)" | grep -q "Careful" \
   && [[ "$(reach "[12, 24, 10, 11].every(p => Reach.key(layout, 18, p).danger)")" == true ]]'

check "Reach: combos on a layer, with their keys and result" \
  '[[ "$(reach "Reach.combos(layout, [0]).filter(c => c.tap == \"F1\").map(c => c.keys)")" == "[[1,13]]" ]] \
   && [[ "$(reach "Reach.combos(layout, [0, 13]).length")" == 0 ]]'

# The Drill engine: tokens in, key presses in; position, errors and blocking out. Times are given, in ms.
eng() { reach "(e => { $1; return [e.pos, e.errors, e.blocked, e.done()]; })(Drill.engine([\"a\", \"b\", \" \", \"c\"]))"; }
check "Drill: a right key moves on" '[[ "$(eng "e.input(\"a\", 0)")" == "[1,0,false,false]" ]]'
check "Drill: a wrong key blocks and counts one error" '[[ "$(eng "e.input(\"a\", 0); e.input(\"x\", 1)")" == "[1,1,true,false]" ]]'
check "Drill: a blocked drill waits for the right key; each wrong key counts" \
  '[[ "$(eng "e.input(\"a\", 0); e.input(\"x\", 1); e.input(\"c\", 2)")" == "[1,2,true,false]" ]] \
   && [[ "$(eng "e.input(\"a\", 0); e.input(\"x\", 1); e.input(\"b\", 2)")" == "[2,1,false,false]" ]]'
check "Drill: the last right key ends it, with accuracy and words per minute" \
  '[[ "$(eng "[\"a\", \"x\", \"b\", \" \", \"c\"].forEach((k, i) => e.input(k, i * 3000))")" == "[4,1,false,true]" ]] \
   && [[ "$(reach "(e => { [\"a\", \"x\", \"b\", \"c\", \"d\", \"e\"].forEach((k, i) => e.input(k, i * 3000)); return e.stats(); })(Drill.engine(\"abcde\".split(\"\")))" | jq -c "[.accuracy, .wpm]")" == "[0.8333333333333334,4]" ]]'
check "Drill: input after the end changes nothing" '[[ "$(eng "\"ab c\".split(\"\").forEach(k => e.input(k, 0)); e.input(\"x\", 1)")" == "[4,0,false,true]" ]]'
check "Drill: tokens wrap into lines at spaces" \
  '[[ "$(reach "Drill.wrap(\"aa bb cc\".split(\"\"), 5)")" == "[[0,6],[6,8]]" ]] \
   && [[ "$(reach "Drill.wrap(\"aaaaaa b\".split(\"\"), 3)")" == "[[0,7],[7,8]]" ]]'

check "Drill: five letter stages, from the home row out" \
  '[[ "$(reach "Drill.stages(layout, keys).slice(0, 5).map(s => s.letters.slice().sort().join(\"\"))")" \
      == "[\"aeghinrsty\",\"abcdefghijlnorstuvy\",\"abcdefghijklmnopqrstuvwxyz\",\"abcdefghijklmnopqrstuvwxyz\",\"abcdefghijklmnopqrstuvwxyz\"]" ]] \
   && [[ "$(reach "Drill.stages(layout, keys)[4].punct.join(\"\")")" == "\",.;'\''\"" && "$(reach "Drill.stages(layout, keys)[4].capsWord")" == true ]]'
# Swap G (home row) and Q (bottom row) in the Layout: the stages follow.
jq '.layers[0][29] as $g | .layers[0][29] = .layers[0][38] | .layers[0][38] = $g' "$ROOT/config/go60.json" \
  | "$ROOT/bin/go60-train" > "$T/swap.html"
check "Drill: each stage's letters come from the Layout's rows" \
  '[[ "$(page="$T/swap.html" reach "Drill.stages(layout, keys)[0].letters.slice().sort().join(\"\")")" == "\"aehinqrsty\"" ]]'

# A seeded random source, so the suite is repeatable.
rng='(s => () => (s = (s * 16807) % 2147483647) / 2147483647)(42)'
check "Drill: a letter drill is three lines of words that use only the stage's letters" \
  '[[ "$(reach "(r => [0, 1, 2, 3].every(n => [...Array(20)].every(() => { const t = Drill.generate(layout, keys, n, r); const ok = Drill.stages(layout, keys)[n].letters.concat([\" \"]); return t.length > 100 && Drill.wrap(t, Drill.WIDTH).length == 3 && t.every(c => ok.includes(c)); })))($rng)")" == true ]]'
check "Drill: the last stage has capitals, , . ; '\'' and Caps Word words" \
  '[[ "$(reach "(r => { const t = [...Array(30)].map(() => Drill.generate(layout, keys, 4, r).join(\"\")).join(\" \"); return [/[A-Z][a-z]/.test(t), /,/.test(t), /\\./.test(t), /;/.test(t), /'\''/.test(t), /\\b[A-Z]{2,}\\b/.test(t)]; })($rng)")" == "[true,true,true,true,true,true]" ]]'
check "Drill: every token a letter stage generates is reachable, with a hint" \
  '[[ "$(reach "(r => [0, 1, 2, 3, 4].every(n => [...Array(30)].every(() => { const t = Drill.generate(layout, keys, n, r); return t.every((c, i) => Reach.reach(layout, c) && Drill.hint(layout, t, i)); })))($rng)")" == true ]]'
check "Drill: the hint lights the key to tap and the key to hold" \
  '[[ "$(reach "(h => [h.hold, h.tap])(Drill.hint(layout, [\"a\"], 0))")" == "[[],[32]]" ]] \
   && [[ "$(reach "(h => [h.hold, h.tap])(Drill.hint(layout, [\"A\", \"n\"], 0))")" == "[[28],[32]]" ]]'
check "Drill: a capitals word lights Caps Word, then plain letters" \
  '[[ "$(reach "(t => [0, 1].map(i => (h => [h.hold, h.tap])(Drill.hint(layout, t, i))))([\"A\", \"N\"])")" == "[[[],[56,32]],[[],[25]]]" ]]'
check "Drill: two Symbol stages follow the letters" \
  '[[ "$(reach "Drill.stages(layout, keys).slice(5).map(s => [s.layer, s.symbols.length])")" == "[[13,32],[13,32]]" ]]'
check "Drill: the Symbol stages draw every symbol the Reach module finds on Symbol, and nothing else" \
  '[[ "$(reach "(s => { const on = layout.layers[13].map((b, p) => Reach.key(layout, 13, p).types).filter(t => t && t.length == 1 && /[^a-z0-9 ]/i.test(t)); return on.every(c => s.includes(c)) && s.every(c => on.includes(c)); })(Drill.stages(layout, keys)[5].symbols)")" == true ]]'
check "Drill: stage 1 of Symbol is short random groups of its symbols" \
  '[[ "$(reach "(r => [...Array(20)].every(() => { const t = Drill.generate(layout, keys, 5, r), s = Drill.stages(layout, keys)[5].symbols; const g = t.join(\"\").split(\" \"); return Drill.wrap(t, Drill.WIDTH).length == 3 && g.every(x => x.length >= 2 && x.length <= 5 && x.split(\"\").every(c => s.includes(c))); }))($rng)")" == true ]]'
check "Drill: stage 2 of Symbol is built-in shell and Python lines" \
  '[[ "$(reach "(r => { const t = Drill.generate(layout, keys, 6, r).join(\"\"); return [Drill.wrap(t.split(\"\"), Drill.WIDTH).length, /[a-z]/.test(t), /[(){}\\[\\]|$=]/.test(t)]; })($rng)")" == "[3,true,true]" ]]'
check "Drill: every token the Symbol stages generate is reachable, with a hint" \
  '[[ "$(reach "(r => [5, 6].every(n => [...Array(30)].every(() => { const t = Drill.generate(layout, keys, n, r), st = Drill.stages(layout, keys)[n]; return t.length > 50 && t.every((c, i) => Reach.reach(layout, c) && Drill.hint(layout, t, i, st)); })))($rng)")" == true ]]'
check "Drill: in the Symbol stages a symbol is hinted through Symbol, even where a base key sends it" \
  '[[ "$(reach "(st => [\",\", \"(\", \"?\"].map(c => (h => [h.hold, h.tap, h.layer])(Drill.hint(layout, [c], 0, st))))(Drill.stages(layout, keys)[5])")" == "[[[59],[1],13],[[59],[2],13],[[59],[17],13]]" ]] \
   && [[ "$(reach "(h => [h.hold, h.tap])(Drill.hint(layout, [\",\"], 0))")" == "[[],[22]]" ]] \
   && [[ "$(reach "(r => [5, 6].every(n => { const st = Drill.stages(layout, keys)[n], t = Drill.generate(layout, keys, n, r); return t.every((c, i) => !st.symbols.includes(c) || (h => h.layer == 13 && h.hold.join() == \"59\")(Drill.hint(layout, t, i, st))); }))($rng)")" == true ]]'
jq '.layer_names[13] = "Glyphs"' "$ROOT/config/go60.json" | "$ROOT/bin/go60-train" > "$T/glyphs.html"
check "Drill: the Symbol stages find their layer when it is renamed" \
  '[[ "$(page="$T/glyphs.html" reach "Drill.stages(layout, keys).slice(5).map(s => [s.layer, s.symbols.length])")" == "[[13,32],[13,32]]" ]]'
# The Symbol layer emptied: no layer carries more symbols than the base, so there is none to drill.
jq '.layers[13] |= map({value: "&trans", params: []})' "$ROOT/config/go60.json" | "$ROOT/bin/go60-train" > "$T/nosym.html"
check "Drill: with no symbol layer the Symbol stages are still listed and fail loud" \
  '[[ "$(page="$T/nosym.html" reach "Drill.stages(layout, keys).length")" == 7 ]] \
   && [[ "$(page="$T/nosym.html" reach "[5, 6].map(n => { try { Drill.generate(layout, keys, n); return \"no error\"; } catch (e) { return e.message; } }).join(\" | \")")" == *"Symbols: random groups"*"no layer"*"Symbols: shell"*"no layer"* ]]'
# E and S made F13: every built-in line has an E or an S, so none can be sent.
jq '(.. | objects | select(.value == "E" or .value == "S") | .value) = "F13"' "$ROOT/config/go60.json" \
  | "$ROOT/bin/go60-train" > "$T/noes.html"
check "Drill: Symbol lines with no line this Layout can send fail loud, naming the stage" \
  '[[ "$(page="$T/noes.html" reach "(() => { try { Drill.generate(layout, keys, 6); return \"no error\"; } catch (e) { return e.message; } })()")" == *"Symbols: shell and Python lines: no built-in line"* ]]'
# Every Space made F13: the pieces of a Symbol drill have nothing to go between them.
jq '(.. | objects | select(.value == "SPACE") | .value) = "F13"' "$ROOT/config/go60.json" \
  | "$ROOT/bin/go60-train" > "$T/nospace.html"
check "Drill: Symbol drills with no Space fail loud, naming the stage" \
  '[[ "$(page="$T/nospace.html" reach "[5, 6].map(n => { try { Drill.generate(layout, keys, n); return \"no error\"; } catch (e) { return e.message; } }).join(\" | \")")" == *"random groups: "*"Space"*"Python lines: "*"Space"* ]]'
check "Drill: a symbol counts by what the board sent, whichever path sent it" \
  '[[ "$(reach "(e => [e.input(\"(\", 0), e.input(\")\", 1)])(Drill.engine([\"(\", \")\"]))")" == "[\"ok\",\"done\"]" ]]'
# Every home-row letter made Q: no common word fits the Home row stage.
jq '(.layers[0][25,26,27,28,31,32,33,34].params[1].value, .layers[0][29,30].params[0].value) = "Q"' "$ROOT/config/go60.json" \
  | "$ROOT/bin/go60-train" > "$T/nowords.html"
check "Drill: a stage with no words fails loud, naming the stage" \
  '[[ "$(page="$T/nowords.html" reach "(() => { try { Drill.generate(layout, keys, 0); return \"no error\"; } catch (e) { return e.message; } })()")" == *"Home row"* ]]'
check "Drill: Tab toggles the picture, mid-drill too; drill keys still type" \
  '[[ "$(reach "[{key: \"Tab\"}, {key: \"h\"}, {key: \"a\", ctrlKey: true}, {key: \"Shift\"}, {key: \"A\", shiftKey: true}].map(Drill.read)")" == "[\"picture\",\"h\",\"chord\",null,\"A\"]" ]]'
check "Drill: the picture key is never a token a drill asks for, and the board can send it" \
  '[[ "$(reach "(r => Reach.reach(layout, Drill.PICTURE) && Drill.stages(layout, keys).every((s, n) => [...Array(10)].every(() => !Drill.generate(layout, keys, n, r).includes(Drill.read({key: Drill.PICTURE})) )))($rng)")" == true ]]'
check "Drill: nothing is saved between sessions" '! grep -Eq "localStorage|sessionStorage|indexedDB|document\\.cookie" "$page"'

# --- go60-flash -----------------------------------------------------------

# Stubs: findmnt knows nothing; udisksctl "mounts" DEV_DIR/<label> at MNT_DIR/<label>.
stubs="$T/stubs"; mkdir -p "$stubs"
printf '#!/bin/sh\nexit 1\n' > "$stubs/findmnt"
cat > "$stubs/udisksctl" <<'EOF'
#!/bin/sh
dev=$(echo "$@" | sed 's/.*-b \([^ ]*\).*/\1/')
echo "Mounted $dev at $MNT_DIR/$(basename "$dev")"
EOF
chmod +x "$stubs"/*

# fake_half LABEL [noinfo]: a Bootloader drive that "resets" (vanishes) once a .uf2 lands on it.
fake_half() {
  local dev="$DEV_DIR/$1" mnt="$MNT_DIR/$1"
  mkdir -p "$mnt"; [[ "${2:-}" == noinfo ]] || echo "UF2 Bootloader" > "$mnt/INFO_UF2.TXT"
  : > "$dev"
  ( for _ in $(seq 100); do ls "$mnt"/*.uf2 >/dev/null 2>&1 && { rm -f "$dev"; exit; }; sleep 0.1; done ) &
}

flash_env() {
  export DEV_DIR="$1/dev" MNT_DIR="$1/mnt" GO60_DEV_DIR="$1/dev" GO60_TIMEOUT=5
  mkdir -p "$DEV_DIR" "$MNT_DIR"
}

img="$T/go60.uf2"; echo firmware > "$img"

f="$T/f1"; flash_env "$f"
fake_half GO60RHBOOT; fake_half GO60LHBOOT
check "go60-flash: flashes right then left" \
  'PATH="$stubs:$PATH" "$ROOT/bin/go60-flash" "$img" </dev/null >"$f/log" 2>&1 \
   && cmp -s "$MNT_DIR/GO60RHBOOT/go60.uf2" "$img" && cmp -s "$MNT_DIR/GO60LHBOOT/go60.uf2" "$img"'

f="$T/f2"; flash_env "$f"
fake_half GO60RHBOOT noinfo
check "go60-flash: refuses a drive without INFO_UF2.TXT" \
  '! PATH="$stubs:$PATH" "$ROOT/bin/go60-flash" "$img" </dev/null >"$f/log" 2>&1 \
   && grep -q "not a Go60 bootloader drive" "$f/log" && [[ ! -e "$MNT_DIR/GO60RHBOOT/go60.uf2" ]]'

f="$T/f3"; flash_env "$f"; export GO60_TIMEOUT=1
check "go60-flash: times out loudly with no drive" \
  '! PATH="$stubs:$PATH" "$ROOT/bin/go60-flash" "$img" </dev/null >"$f/log" 2>&1 && grep -q "timed out" "$f/log"'

# CI path: git and gh stubbed; gh "downloads" a go60.uf2 and records where.
ci="$T/ci"; mkdir -p "$ci"
printf '#!/bin/sh\ncase "$1" in rev-parse) echo abc1234 ;; branch) echo "  origin/main" ;; esac\n' > "$ci/git"
cat > "$ci/gh" <<'EOF'
#!/bin/sh
case "$1 $2" in
  "run list") echo 42 ;;
  "run download") d=$(echo "$@" | sed 's/.*-D \([^ ]*\).*/\1/'); echo firmware > "$d/go60.uf2"; echo "$d" > "$CI_LOG" ;;
esac
EOF
chmod +x "$ci"/*

f="$T/f4"; flash_env "$f"; export GO60_TIMEOUT=5 CI_LOG="$T/f4/dl"
fake_half GO60RHBOOT; fake_half GO60LHBOOT
check "go60-flash: CI image flashes, exits 0 and removes its download" \
  'PATH="$ci:$stubs:$PATH" "$ROOT/bin/go60-flash" </dev/null >"$f/log" 2>&1 \
   && ! grep -q unbound "$f/log" && [[ -s "$CI_LOG" && ! -e "$(cat "$CI_LOG")" ]] \
   && [[ -f "$MNT_DIR/GO60LHBOOT/go60.uf2" ]]'

check "go60-flash: refuses a non-.uf2 file" \
  '! "$ROOT/bin/go60-flash" "$ROOT/README.md" >/dev/null 2>&1'

# --- .github/tag ----------------------------------------------------------

# A bare "remote" with v1..v3 on older commits; the clone's HEAD is untagged.
r="$T/tag"; mkdir -p "$r"
git init -q --bare "$r/origin.git" && git -C "$r" clone -q origin.git work 2>/dev/null
gt() { git -C "$r/work" -c user.name=t -c user.email=t@t "$@"; }
for n in 1 2 3; do gt commit -q --allow-empty -m "c$n" && gt tag "v$n"; done
gt tag v10-rc; gt commit -q --allow-empty -m c4 && gt push -q origin HEAD:main --tags
gt tag -d v1 v2 v3 v10-rc >/dev/null
tag() { (cd "$r/work" && "$ROOT/.github/tag"); }
check "tag: tags HEAD with the highest remote v<N> plus one" \
  '[[ "$(tag)" == v4 ]] && [[ "$(git -C "$r/origin.git" rev-parse v4)" == "$(gt rev-parse HEAD)" ]]'
check "tag: a rerun on a tagged commit makes no second tag" \
  '[[ "$(tag)" == v4 ]] && [[ -z "$(git -C "$r/origin.git" tag -l v5)" ]]'

# --- .sandcastle/tracker --------------------------------------------------

k="$T/tracker"; mkdir -p "$k/.scratch/f/issues"
printf '# 01: a\n\n**Status:** ready-for-agent\n\n- [ ] x\n' > "$k/.scratch/f/issues/01-a.md"
printf '# 02: b\n\n**Blocked by:** 01\n\n**Status:** ready-for-agent\n' > "$k/.scratch/f/issues/02-b.md"
git -C "$k" init -q && git -C "$k" add . && git -C "$k" -c user.name=t -c user.email=t@t commit -qm init
trk() { (cd "$k" && GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t "$ROOT/.sandcastle/tracker" "$@"); }
check "tracker: list skips blocked tickets" \
  '[[ "$(trk list | jq -r "map(.id)|join(\",\")")" == ".scratch/f/issues/01-a.md" ]]'
check "tracker: close resolves, comments and commits" \
  'trk close .scratch/f/issues/01-a.md done && grep -q "^\*\*Status:\*\* resolved$" "$k/.scratch/f/issues/01-a.md" \
   && grep -q "Closed by RALPH: done" "$k/.scratch/f/issues/01-a.md" && [[ -z "$(git -C "$k" status --porcelain)" ]]'
check "tracker: close keeps the blank line after Status" \
  '[[ -z "$(sed -n "/Status/{n;p;}" "$k/.scratch/f/issues/01-a.md")" ]]'
check "tracker: closing 01 unblocks 02" \
  '[[ "$(trk list | jq -r "map(.id)|join(\",\")")" == ".scratch/f/issues/02-b.md" ]]'
printf '# 03: c\n\n**Status:** ready-for-agent\n' > "$k/.scratch/f/issues/03-c.md" && git -C "$k" add . && git -C "$k" -c user.name=t -c user.email=t@t commit -qm c
check "tracker: list <path> lists only that ticket" \
  '[[ "$(trk list .scratch/f/issues/03-c.md | jq -r "map(.id)|join(\",\")")" == ".scratch/f/issues/03-c.md" ]]'
check "tracker: list with an empty path lists every ready ticket" \
  '[[ "$(trk list "" | jq length)" == 2 ]]'
check "tracker: list <unknown path> fails" '! trk list .scratch/f/issues/09-x.md >/dev/null 2>&1'
check "tracker: refuses an unknown ticket" '! trk view nope 2>/dev/null'

wait
if ((FAILS)); then printf '%d failed\n' "$FAILS"; exit 1; fi
echo "all passed"
