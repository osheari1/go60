#!/usr/bin/env python3
"""tracker: Sandcastle's view of the local markdown tracker (docs/agents/issue-tracker.md).

  tracker list [ID...]   open, unblocked `ready-for-agent` tickets as a JSON array;
                         with IDs, only those (empty IDs are ignored)
  tracker view <ID>      print one ticket
  tracker close <ID> <MSG>  set Status: resolved, append MSG under ## Comments, commit

ID is the ticket path from the repo root, e.g. .scratch/go60-trainer/issues/03-letter-drills.md.
Run from the repo root. Exits non-zero with a message on stderr on any error.
"""
import json, re, subprocess, sys
from pathlib import Path

STATUS = re.compile(r"^(\**Status:\**[ \t]*)(.+?)[ \t]*$", re.M)
BLOCKED = re.compile(r"^\**Blocked by:\**[ \t]*(.+?)[ \t]*$", re.M)


def die(msg):
    sys.exit(f"tracker: {msg}")


def status(text):
    m = STATUS.search(text)
    return m.group(2).strip("* ") if m else None


def tickets():
    return sorted(Path(".scratch").glob("*/issues/*.md"))


def ticket(tid):
    p = Path(tid)
    if p not in tickets():
        die(f"no ticket {tid}")
    return p


def blockers(p, text):
    m = BLOCKED.search(text)
    nums = re.findall(r"\d+", m.group(1)) if m else []
    for n in nums:
        dep = sorted(p.parent.glob(f"{int(n):02d}-*.md"))
        if not dep:
            die(f"{p}: blocked by {n}, but no such ticket")
        if status(dep[0].read_text()) != "resolved":
            yield str(dep[0])


def cmd_list(ids):
    only = {ticket(i) for i in ids if i}
    out = []
    for p in tickets():
        if only and p not in only:
            continue
        text = p.read_text()
        if status(text) == "ready-for-agent" and not list(blockers(p, text)):
            out.append({"id": str(p), "title": text.splitlines()[0].lstrip("# "), "body": text})
    print(json.dumps(out, indent=2))


def cmd_close(tid, msg):
    p = ticket(tid)
    text = p.read_text()
    if not STATUS.search(text):
        die(f"{tid}: no Status line")
    text = STATUS.sub(lambda m: m.group(1) + "resolved", text, count=1)
    if "\n## Comments" not in text:
        text = text.rstrip("\n") + "\n\n## Comments\n"
    p.write_text(text.rstrip("\n") + f"\n\n- Closed by RALPH: {msg}\n")
    # Commit here: merge-to-head only carries commits back to the host.
    r = subprocess.run(["git", "commit", "-q", "-m", f"RALPH: close {p.stem}", "--", str(p)])
    if r.returncode:
        die(f"git commit failed for {tid}")


def main(argv):
    if argv[:1] == ["list"]:
        cmd_list(argv[1:])
    elif argv[:1] == ["view"] and len(argv) == 2:
        sys.stdout.write(ticket(argv[1]).read_text())
    elif argv[:1] == ["close"] and len(argv) == 3:
        cmd_close(argv[1], argv[2])
    else:
        die("usage: tracker list [ID...] | view <ID> | close <ID> <MSG>")


main(sys.argv[1:])
